<resources>
    <!-- Tema da Splash Screen oficial AndroidX (fundo preto sem flash branco) -->
    <style name="Theme.MissionAttack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#020307</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.MissionAttack.Fullscreen</item>
    </style>

    <!-- Tema do Jogo em Tela Cheia Imersiva -->
    <style name="Theme.MissionAttack.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#020307</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">#020307</item>
        <item name="android:navigationBarColor">#020307</item>
    </style>
</resources>
